# Database (required)
DATABASE_URL=postgresql://youruser:yourpassword@localhost:5432/car_rental

# JWT (required — use a long random string, e.g. openssl rand -hex 32)
JWT_SECRET=replace-with-a-strong-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# File Storage
FILE_STORAGE_PATH=../uploads
GENERATED_DOCS_PATH=../generated_docs

# CORS (comma-separated list of allowed frontend origins)
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# App
APP_ENV=development
DEBUG=true

# Initial admin seed (required when running seed_admin.py)
INITIAL_ADMIN_EMAIL=admin@yourdomain.com
INITIAL_ADMIN_PASSWORD=replace-with-strong-password

# Scheduler timezone (uses pytz names, e.g. Africa/Addis_Ababa, UTC, Europe/London)
SCHEDULER_TIMEZONE=Africa/Addis_Ababa

# Telegram
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_MODE=disabled
TELEGRAM_POLLING_TIMEOUT_SECONDS=20
TELEGRAM_LINK_CODE_EXPIRY_MINUTES=10
